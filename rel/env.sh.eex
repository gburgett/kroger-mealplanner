#!/bin/sh
# The BEAM must run with UTF-8 name encoding or Elixir mangles non-ASCII output
# (the tree view's box-drawing characters, recipe text). The build machine's
# locale is not guaranteed, so force it here for every `bin/mealplan` command.
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-+fnu}"
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
