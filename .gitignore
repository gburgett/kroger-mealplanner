# --- Rust CLI and the sandbox image it is staged into ---
target/
*.wasm
sandbox-image/rootfs/
cli/target/

.env
.env.elixir

# --- Elixir / Phoenix (the server, per ADR 0020 / plan 0005) ---

# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
mealplan-*.tar

# The state database (ADR 0024). One SQLite file, plus the -wal and -shm files
# it opens beside it. `mealplan_dev.db` for the dev server, one
# `mealplan_test<partition>.db` per test partition.
*.db
*.db-shm
*.db-wal

# The microsandbox session-layer image (ADR 0027); built by build.sh --microsandbox
sandbox-image/oci.tar

# Core dumps (msb/node has been seen to dump one when its guest agent is killed)
core
core.*
