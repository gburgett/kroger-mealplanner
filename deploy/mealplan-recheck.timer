[Unit]
Description=Run the weekly consumable recheck once a week
Documentation=file:///home/exedev/kroger-mealplanner/docs/adr/0018-run-a-weekly-llm-job-to-recheck-consumables.md

[Timer]
# Once a week is the whole schedule — recheck.ts itself decides whether there
# is anything to do, by asking git how old the last commit is (ADR 0018), so
# firing on a quiet week costs one `git log` inside one sandbox invocation.
OnCalendar=Mon *-*-* 03:00:00
# A missed firing (the machine was off at 03:00 Monday) still happens once
# it is back, rather than waiting a full week for the next one.
Persistent=true
# Spread across up to 10 minutes so a fleet of these VMs does not all wake at
# once. One household on one VM does not need this today, but it costs
# nothing and the multi-tenant lens (AGENTS.md) will want it later.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
