[Unit]
# The MCP server: a sandboxed shell over the meal-plan folder.
#
# THIS FILE IS THE ONE THAT IS INSTALLED, and it is a USER unit — it is copied
# to ~/.config/systemd/user/mealplan.service and driven with `systemctl --user`.
# `sudo systemctl` addresses a different manager and will not find it.
#
#     cp deploy/mealplan.service ~/.config/systemd/user/mealplan.service
#     systemctl --user daemon-reload
#     systemctl --user enable --now mealplan.service
#     loginctl enable-linger "$USER"   # or it stops when you log out
#
# It drifts if somebody edits the installed copy instead of this one, and
# nothing warns about that, so the check is written down:
#
#     diff deploy/mealplan.service ~/.config/systemd/user/mealplan.service
#
# CONCRETE, NOT A TEMPLATE. Every path and address below is this machine's. That
# is on purpose: the lens is one household on one machine (ADR 0008), and a
# template with placeholders would describe a multi-machine story this product
# does not have. On another machine, change WorkingDirectory, ExecStart,
# MEALPLAN_PUBLIC_URL, MEALPLAN_OWNER, MEALPLAN_FOLDER, MEALPLAN_STATE and
# EnvironmentFile. Nothing here is a secret: the owner's address and the public
# URL are both in AGENTS.md already, and the Kroger and Walmart credentials
# are the one thing that is NOT in this file.
#
# Deployment procedure, and the warning about going public:
#   docs/deploying-behind-exe-dev.md
Description=Kroger meal planner MCP server
Documentation=file:///home/exedev/kroger-mealplanner/docs/deploying-behind-exe-dev.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/exedev/kroger-mealplanner
# node 24 strips the types itself; there is no build step to run first (ADR 0002).
# The "24" symlink is mise's stable major-version alias, so a 24.x patch bump
# does not break this line.
ExecStart=/home/exedev/.local/share/mise/installs/node/24/bin/node server.ts

# 0.0.0.0 because the exe.dev proxy reaches the VM over eth0, not loopback.
Environment=MEALPLAN_HOST=0.0.0.0
# Must be the same number as `ssh exe.dev share port gb-kroger-mealplanner`.
# 8765 is the code default; this machine is pinned to 8000.
Environment=MEALPLAN_PORT=8000
# The OAuth issuer. Configuration, never the Host header: an issuer read from a
# header is host-header injection into the metadata document (ADR 0009).
Environment=MEALPLAN_PUBLIC_URL=https://gb-kroger-mealplanner.exe.xyz
Environment=MEALPLAN_OWNER=gordon@gordonburgett.net
Environment=MEALPLAN_FOLDER=/home/exedev/meal-plan
Environment=MEALPLAN_STATE=/home/exedev/.local/state/mealplan/auth.json
# systemd-run, prlimit, bwrap and git all live here. The sandbox gets an empty
# environment regardless: `env -i` sits between prlimit and bwrap.
Environment=PATH=/usr/bin:/bin

# KROGER_CLIENT_ID and KROGER_CLIENT_SECRET, from the one gitignored file that
# holds them (ADR 0010). Read from a file rather than written into this unit:
# this unit is world-readable and in git, and .env is 0600 and is not. The
# household's own Kroger credential is a third file, which the server writes
# itself, beside auth.json and equally outside the meal-plan folder.
#
# Walmart's credential travels the same path (ADR 0017): WALMART_CONSUMER_ID
# and WALMART_PRIVATE_KEY_PATH in .env, pointing at a 0600 PEM. It is the
# server's own signing key — there is no household Walmart credential at all.
#
# The leading "-" makes the file optional. Without it the server starts and
# works exactly as before — the consent page drops the Kroger checkbox and the
# Kroger and Walmart tools refuse and say what is missing. Losing the whole
# meal planner over an optional feature would be the worse failure.
EnvironmentFile=-/home/exedev/kroger-mealplanner/.env

# The server exits 0 on SIGTERM, so a deliberate stop stays stopped.
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# No NoNewPrivileges=, RestrictNamespaces= or PrivateUsers= here on purpose:
# the product's whole boundary is bubblewrap creating user and pid namespaces
# per command, and those three would break it. The containment lives in
# sandbox-image/, not in this unit.

[Install]
WantedBy=default.target
