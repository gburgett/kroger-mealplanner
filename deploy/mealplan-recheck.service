[Unit]
# The weekly consumable recheck job. One run, then it exits — see
# deploy/mealplan-recheck.timer for what actually schedules it. Type=oneshot,
# because there is no daemon here at all: recheck.ts opens its own sandbox
# session, drives one LLM tool loop, and exits.
#
# THIS FILE IS THE ONE THAT IS INSTALLED, and it is a USER unit, the same
# pattern as deploy/mealplan.service:
#
#     cp deploy/mealplan-recheck.service ~/.config/systemd/user/mealplan-recheck.service
#     cp deploy/mealplan-recheck.timer   ~/.config/systemd/user/mealplan-recheck.timer
#     systemctl --user daemon-reload
#     systemctl --user enable --now mealplan-recheck.timer
#     loginctl enable-linger "$USER"   # or it stops when you log out
#
# It drifts if somebody edits the installed copy instead of this one:
#
#     diff deploy/mealplan-recheck.service ~/.config/systemd/user/mealplan-recheck.service
#
# CONCRETE, NOT A TEMPLATE, the same reasoning as mealplan.service: one
# household, one machine (ADR 0008). On another machine, change
# WorkingDirectory, ExecStart, MEALPLAN_FOLDER and EnvironmentFile.
#
# See ADR 0018 and docs/deploying-behind-exe-dev.md.
Description=Weekly consumable recheck for the Kroger meal planner
Documentation=file:///home/exedev/kroger-mealplanner/docs/adr/0018-run-a-weekly-llm-job-to-recheck-consumables.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/exedev/kroger-mealplanner
# node 24 strips the types itself; there is no build step (ADR 0002). Same
# "24" mise alias mealplan.service uses.
ExecStart=/home/exedev/.local/share/mise/installs/node/24/bin/node recheck.ts

Environment=MEALPLAN_FOLDER=/home/exedev/meal-plan
# exe.dev's LLM gateway. No API key: the integration authenticates by this
# VM's own network identity, so there is nothing here to put in .env. Left
# unset to take the code default (https://llm.int.exe.xyz/anthropic) — set
# only to redirect at a mock, which production never does.
#Environment=MEALPLAN_LLM_BASE=https://llm.int.exe.xyz/anthropic
# systemd-run, prlimit, bwrap and git all live here. The sandbox gets an empty
# environment regardless: env -i sits between prlimit and bwrap.
Environment=PATH=/usr/bin:/bin

# journald reads the syslog priority off the `<7>`/`<3>` prefix each log line
# already carries (ADR 0018) — no SyslogLevelPrefix= override needed, it
# defaults to on for a unit's own stdout.
StandardOutput=journal
StandardError=journal

# No Restart= here on purpose: a oneshot that failed this week gets a fresh
# attempt from the timer next week, not a retry loop competing with it.
#
# No [Install] section: this unit is triggered by mealplan-recheck.timer, not
# enabled directly. `systemctl --user enable` targets the timer.
