[Unit]
# The Elixir/Phoenix MCP server (ADR 0020, plan 0005). Runs a `mix release`
# instead of `node server.ts`.
#
# THIS FILE IS THE ONE THAT IS INSTALLED, and it is a USER unit — the same
# pattern as deploy/mealplan.service:
#
#     cp deploy/mealplan-elixir.service ~/.config/systemd/user/mealplan-elixir.service
#     systemctl --user daemon-reload
#     systemctl --user enable --now mealplan-elixir.service
#     loginctl enable-linger "$USER"   # or it stops when you log out
#
#     diff deploy/mealplan-elixir.service ~/.config/systemd/user/mealplan-elixir.service
#
# CONCRETE, NOT A TEMPLATE. Every path and address below is this machine's, the
# same reasoning as deploy/mealplan.service.
#
# ADR 0033: this server now admits more than one invited household, each with
# its own tenant and its own folder under MEALPLAN_CORPUS_ROOT, each in its own
# libkrun microVM (MEALPLAN_SANDBOX=microsandbox). There is no configured owner.
#
# THE CUTOVER HAPPENED: this is the server now, on port 8000, against the
# real /home/exedev/meal-plan. It ran alongside the Node service for the rest
# of the migration, on 8001 against its own /home/exedev/meal-plan-elixir
# folder, so the two servers never committed to one git repository at once.
# deploy/mealplan.service is stopped and disabled; it stays in the repository
# until plan 0005 Phase 9 deletes the Node source it starts.
#
# DEPLOY = `mix release` THEN RESTART. There is a build step now (ADR 0020):
#
#     cd /home/exedev/kroger-mealplanner
#     git pull
#     MIX_ENV=prod mix deps.get --only prod
#     MIX_ENV=prod mix release --overwrite
#     systemctl --user restart mealplan-elixir.service
#
# A change to cli/ still needs ./cli/build.sh and a change to the sandbox image
# still needs ./sandbox-image/build.sh — unchanged by this migration.
Description=Kroger meal planner MCP server (Elixir)
Documentation=file:///home/exedev/kroger-mealplanner/docs/adr/0020-migrate-the-server-and-jobs-to-elixir-phoenix-and-postgres.md
# Nothing on this VM to order against. The state is one SQLite file (ADR 0024,
# restored by ADR 0030) — no database server. The SuperTokens core is the
# managed deployment (ADR 0029), off this VM, reached over the network.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/exedev/kroger-mealplanner
# The release. `mix release` writes it here; there is no daemon, one BEAM node
# holds the server, the sandbox children and (Phase 6) the Oban job.
ExecStart=/home/exedev/kroger-mealplanner/_build/prod/rel/mealplan/bin/mealplan start
ExecStop=/home/exedev/kroger-mealplanner/_build/prod/rel/mealplan/bin/mealplan stop

# The endpoint only serves in a release when this is set.
Environment=PHX_SERVER=true
# The port exe.dev's proxy reaches this VM on (`ssh exe.dev share port`).
Environment=MEALPLAN_PORT=8000
# The OAuth issuer. Configuration, never the Host header (ADR 0009). This is
# now the address exe.dev points the public hostname at.
Environment=MEALPLAN_PUBLIC_URL=https://gb-kroger-mealplanner.exe.xyz
# ADR 0033: there is no configured owner and no bootstrap household. Every
# household is invited by hand — `bin/mealplan eval
# 'Mealplan.Invitations.create("+15095550142", label: "...")'` — and the first
# code that number spends provisions its own tenant and a fresh folder under
# MEALPLAN_CORPUS_ROOT. MEALPLAN_OWNER and MEALPLAN_OWNER_PHONE are gone.
Environment=MEALPLAN_CORPUS_ROOT=/home/exedev/meal-plans
# The old single-household folder (ADR 0033). Kept named ONLY as a pointer for
# a follow-up record that moves its recipes and meals into the re-onboarded
# tenant. Nothing reads it at runtime; the current household re-onboards from
# empty as an ordinary invitee.
Environment=MEALPLAN_FOLDER=/home/exedev/meal-plan
# The SuperTokens core — the managed deployment (ADR 0029), over HTTPS. Its
# API key travels in .env.elixir, not here: it is the whole of the lock on the
# user store, and this file is world-readable and in git.
Environment=SUPERTOKENS_CONNECTION_URI=https://st-dev-ff40b340-a989-11f1-abbd-07395602a114.aws.supertokens.io
# "twilio" or "telnyx". Both are built; this picks. The credentials for
# whichever one this names travel in .env, never here.
Environment=MEALPLAN_SMS_PROVIDER=twilio

# The server state, one SQLite file (ADR 0024, restored by ADR 0030). It has a
# password-free path, so unlike DATABASE_URL it lives here rather than in .env.
# It MUST be outside MEALPLAN_CORPUS_ROOT and outside every tenant's folder —
# a sandbox mounts those and the file holds a household's Kroger token in the
# clear — and `Mealplan.Boot` refuses to start if it is not.
# ~/.local/state/mealplan/mealplan.db is the default; this names it so a reader
# of the unit knows where the state is.
Environment=MEALPLAN_STATE=/home/exedev/.local/state/mealplan/mealplan.db
# systemd-run, prlimit, bwrap and git all live here. The sandbox gets an empty
# environment regardless: `env -i` sits between prlimit and bwrap.
Environment=PATH=/usr/bin:/bin
# ADR 0033: the deployed server admits more than one household, so each one
# runs in its own libkrun microVM (ADR 0027). bubblewrap between tenants is one
# UID namespace, not a kernel. This needs `msb` on PATH, /dev/kvm read/write
# (`msb doctor`), and sandbox-image/oci.tar built with
# `./sandbox-image/build.sh --microsandbox`. See docs/deploying-behind-exe-dev.md.
Environment=MEALPLAN_SANDBOX=microsandbox
# The BEAM must run UTF-8 or Elixir mangles non-ASCII output. rel/env.sh.eex
# also sets these; belt and braces.
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=ELIXIR_ERL_OPTIONS=+fnu

# SECRET_KEY_BASE, from the gitignored 0600 file — this unit is world-readable
# and in git. It signs the household's session cookie now as well as everything
# else it signed before (ADR 0027), so rotating it signs everybody out.
#
# KROGER_CLIENT_ID / KROGER_CLIENT_SECRET and the Walmart credential travel the
# same path. So do the ones that arrived with ADR 0027 and ADR 0029:
#
#     SUPERTOKENS_API_KEY=...          # the managed core's key, from its dashboard
#     MEALPLAN_SMS_FROM=+1...          # the number codes are sent FROM
#     TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=...
#     # or, for Telnyx: TELNYX_API_KEY=... TELNYX_MESSAGING_PROFILE_ID=...
#
# None of these has a default that fails loudly the way a database once did:
# the state is a file with a default path (above), so there is no DATABASE_URL
# to forget. SUPERTOKENS_API_KEY has no default, but the server still starts
# without it — the "sign-in:" journal line says NO API KEY and every code
# request then fails (ADR 0029). The SMS credentials are optional the same way
# the Kroger ones are.
EnvironmentFile=-/home/exedev/kroger-mealplanner/.env
EnvironmentFile=-/home/exedev/kroger-mealplanner/.env.elixir

# The BEAM exits 0 on SIGTERM, so a deliberate stop stays stopped.
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

# No NoNewPrivileges=, RestrictNamespaces= or PrivateUsers= here, on purpose:
# the product's whole boundary is bubblewrap creating user and pid namespaces
# per command, and those three would break it. Containment lives in
# sandbox-image/, not in this unit.

[Install]
WantedBy=default.target
